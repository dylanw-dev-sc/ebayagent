# eBay Clothing Finder — environment configuration
# Copy this file to .env.local and fill in values. .env.local is git-ignored.
# NEVER commit real credentials.

# --- Data source -------------------------------------------------------------
# "ebay"    → official eBay Browse API (requires the credentials below)
# "fixture" → clearly labeled synthetic sample data (no network, no credentials)
# Leave empty to auto-select: eBay when credentials are present, otherwise fixtures.
LISTING_PROVIDER=

# --- eBay API credentials (from https://developer.ebay.com → Application Keys) ---
# Use the PRODUCTION keyset's App ID (Client ID) and Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production (default) or sandbox (sandbox returns test data, not real listings)
EBAY_ENVIRONMENT=production
# Marketplace to search (this app targets the US marketplace and USD)
EBAY_MARKETPLACE_ID=EBAY_US
# Optional 5-digit US ZIP code. When set, eBay can return calculated-shipping
# estimates for your location; otherwise calculated shipping stays "unknown".
EBAY_DELIVERY_ZIP=

# --- Online new prices (optional) -------------------------------------------
# Brave Search API key (https://brave.com/search/api/, "Search" plan). Used to
# look up typical new prices for the Cost Evaluator. Capped at 1,000 searches a
# month (Brave's $5 monthly credit). Test with: npm run retail:check -- "<query>"
BRAVE_SEARCH_API_KEY=

# --- Storage -----------------------------------------------------------------
# SQLite database file (created automatically). Default: ./data/ebay-finder.db
DATABASE_PATH=
